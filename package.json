{
  "name": "autoapply-mcp",
  "version": "0.3.0",
  "description": "AI job application agent: an MCP server that finds jobs on Greenhouse, Lever, Ashby and Workday and drafts every application, which your agent sends with its own browser after you approve.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "job-search",
    "ats",
    "greenhouse",
    "lever",
    "ashby",
    "automation",
    "mcp-server",
    "ai-agent",
    "job-application",
    "auto-apply",
    "job-automation",
    "workday",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pugarte7/autoapply-mcp.git"
  },
  "homepage": "https://github.com/pugarte7/autoapply-mcp#readme",
  "bugs": {
    "url": "https://github.com/pugarte7/autoapply-mcp/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "autoapply-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "presets",
    "examples",
    "docs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "preset:spain": "npm run build && node scripts/build-spain-preset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "doctor": "node dist/cli/doctor.js",
    "approve": "node dist/cli/approve.js",
    "init": "node dist/cli/init.js",
    "prepublishOnly": "npm run build && npm test",
    "eval": "npm run build && node evals/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
